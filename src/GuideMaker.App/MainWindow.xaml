<Window x:Class="GuideMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuideMaker"
        Height="760"
        Width="1360"
        MinHeight="620"
        MinWidth="1180"
        FontFamily="Segoe UI"
        Background="#F8FAFD"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F8FAFD" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1A73E8" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1558B0" />
        <SolidColorBrush x:Key="TextBrush" Color="#202124" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6368" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADCE0" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F1F3F4" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="GuideMaker"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="ProjectPathTextBlock"
                               Text="No project open"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Content="Dark"
                                  Margin="0,0,8,0"
                                  Click="ThemeToggleButton_Click" />
                    <Button x:Name="NewGuideButton"
                            Content="New"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Click="NewGuideButton_Click" />
                    <Button x:Name="OpenGuideButton"
                            Content="Open"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Click="OpenGuideButton_Click" />
                    <Button x:Name="SaveGuideButton"
                            Content="Save"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveGuideButton_Click" />
                    <Button x:Name="PreviewGuideButton"
                            Content="Preview"
                            MinWidth="104"
                            Margin="0,0,8,0"
                            Click="PreviewGuideButton_Click" />
                    <Button x:Name="ExportGuideButton"
                            Content="Export"
                            MinWidth="92"
                            Click="ExportGuideButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel Margin="14">
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Steps"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Button Grid.Column="1"
                                x:Name="AddStepButton"
                                Content="Add"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Click="AddStepButton_Click" />
                        <Button Grid.Column="2"
                                x:Name="DeleteStepButton"
                                Content="Delete"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Click="DeleteStepButton_Click" />
                    </Grid>

                    <ListBox x:Name="StepsListBox"
                             BorderBrush="{DynamicResource BorderBrushSoft}"
                             SelectionChanged="StepsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding Order}" />
                                        <Run Text=". " />
                                        <Run Text="{Binding Title}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Body}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="20,0,0,0"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Guide"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBox x:Name="GuideTitleTextBox"
                             Grid.Row="1"
                             Margin="0,8,0,18"
                             TextChanged="GuideTitleTextBox_TextChanged" />

                    <TextBlock Grid.Row="2"
                               Text="Selected step"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" />

                    <Grid Grid.Row="3"
                          Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="StepTitleTextBox"
                                 TextChanged="StepTitleTextBox_TextChanged" />
                        <TextBox x:Name="StepBodyTextBox"
                                 Grid.Row="1"
                                 Margin="0,12,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 MinHeight="260"
                                 TextChanged="StepBodyTextBox_TextChanged" />
                    </Grid>

                    <DockPanel Grid.Row="4"
                               Margin="0,18,0,8">
                        <TextBlock Text="Images"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <WrapPanel>
                            <Button x:Name="ImportImageButton"
                                Content="Import"
                                MinWidth="78"
                                Margin="0,0,8,8"
                                Click="ImportImageButton_Click" />
                            <Button x:Name="PasteImageButton"
                                Content="Paste"
                                MinWidth="78"
                                Margin="0,0,8,8"
                                Click="PasteImageButton_Click" />
                            <Button x:Name="CaptureScreenshotButton"
                                Content="Capture"
                                MinWidth="88"
                                Margin="0,0,8,8"
                                Click="CaptureScreenshotButton_Click" />
                            <Button x:Name="InsertImageReferenceButton"
                                Content="Insert ref"
                                MinWidth="96"
                                Margin="0,0,8,8"
                                Click="InsertImageReferenceButton_Click" />
                            <Button x:Name="RemoveImageButton"
                                Content="Remove"
                                MinWidth="88"
                                Margin="0,0,8,8"
                                Click="RemoveImageButton_Click" />
                            <Button x:Name="AddHighlightButton"
                                Content="Highlight"
                                MinWidth="88"
                                Margin="0,0,8,8"
                                Click="AddHighlightButton_Click" />
                            <Button x:Name="AddLabelButton"
                                Content="Label"
                                MinWidth="72"
                                Margin="0,0,8,8"
                                Click="AddLabelButton_Click" />
                            <Button x:Name="AddArrowButton"
                                Content="Arrow"
                                MinWidth="72"
                                Margin="0,0,8,8"
                                Click="AddArrowButton_Click" />
                            <Button x:Name="AddRedactButton"
                                Content="Redact"
                                MinWidth="78"
                                Margin="0,0,8,8"
                                Click="AddRedactButton_Click" />
                            <Button x:Name="RemoveAnnotationButton"
                                Content="Remove mark"
                                MinWidth="104"
                                Margin="0,0,8,8"
                                Click="RemoveAnnotationButton_Click" />
                        </WrapPanel>
                    </DockPanel>

                    <ListBox x:Name="StepAssetsListBox"
                             Grid.Row="5"
                             SelectionChanged="StepAssetsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CanvasBrush}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Width="96"
                                            Height="64">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding FullPath}"
                                                   Stretch="UniformToFill" />
                                            <ItemsControl ItemsSource="{Binding Annotations}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="96"
                                                                Height="64" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding Width}"
                                                                Height="{Binding Height}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                BorderThickness="{Binding BorderThickness}"
                                                                Background="{Binding Background}">
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="#FFFFFF"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Margin="3,1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding RelativePath}"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AnnotationSummary}"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="20,0,0,0"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Preview"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock x:Name="PreviewPathTextBlock"
                                   DockPanel.Dock="Right"
                                   Text="Not generated"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            Background="#FFFFFF">
                        <WebBrowser x:Name="GuidePreviewBrowser" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,9">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="DirtyIndicatorTextBlock"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready. Local-only MVP. No telemetry. No cloud."
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
