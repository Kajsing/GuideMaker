<Window x:Class="GuideMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuideMaker"
        Height="720"
        Width="1120"
        MinHeight="560"
        MinWidth="860">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Background="#FFFFFF"
                   LastChildFill="False">
            <TextBlock Text="GuideMaker"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="16,12" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="0,8,12,8">
                <Button Content="New guide"
                        Padding="12,6"
                        Margin="0,0,8,0" />
                <Button Content="Open"
                        Padding="12,6"
                        Margin="0,0,8,0" />
                <Button Content="Export"
                        Padding="12,6" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1"
              Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Steps"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <ListBox>
                        <ListBoxItem Content="1. Open the application" />
                        <ListBoxItem Content="2. Capture the screen" />
                        <ListBoxItem Content="3. Add annotations" />
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="18"
                    Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="Guide editor shell"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Milestone 1 focuses on the project model, save/load storage, and a stable app shell."
                               Foreground="#555555"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <TextBox Text="Step title"
                             Margin="0,0,0,12" />
                    <TextBox Text="Step instructions"
                             Height="160"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Text="Local-only MVP. No telemetry. No cloud."
                       Foreground="#555555" />
        </Border>
    </Grid>
</Window>
