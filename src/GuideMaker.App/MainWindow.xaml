<Window x:Class="GuideMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuideMaker"
        Height="760"
        Width="1360"
        MinHeight="620"
        MinWidth="1180"
        FontFamily="Segoe UI"
        Background="#F8FAFD"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F8FAFD" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1A73E8" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1558B0" />
        <SolidColorBrush x:Key="TextBrush" Color="#202124" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6368" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADCE0" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F1F3F4" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="GuideMaker"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="ProjectPathTextBlock"
                               Text="No project open"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Content="Dark"
                                  Margin="0,0,8,0"
                                  Click="ThemeToggleButton_Click" />
                    <Button x:Name="NewGuideButton"
                            Content="New"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Click="NewGuideButton_Click" />
                    <Button x:Name="OpenGuideButton"
                            Content="Open"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Click="OpenGuideButton_Click" />
                    <Button x:Name="SaveGuideButton"
                            Content="Save"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveGuideButton_Click" />
                    <Button x:Name="PreviewGuideButton"
                            Content="Preview"
                            MinWidth="104"
                            Margin="0,0,8,0"
                            Click="PreviewGuideButton_Click" />
                    <Button x:Name="ExportGuideButton"
                            Content="Export"
                            MinWidth="92"
                            Click="ExportGuideButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="560" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel Margin="14">
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Steps"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Button Grid.Column="1"
                                x:Name="AddStepButton"
                                Content="Add"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Click="AddStepButton_Click" />
                        <Button Grid.Column="2"
                                x:Name="DeleteStepButton"
                                Content="Delete"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Click="DeleteStepButton_Click" />
                    </Grid>

                    <ListBox x:Name="StepsListBox"
                             BorderBrush="{DynamicResource BorderBrushSoft}"
                             SelectionChanged="StepsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding Order}" />
                                        <Run Text=". " />
                                        <Run Text="{Binding Title}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Body}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="20,0,0,0"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.25*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.35*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Guide"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBox x:Name="GuideTitleTextBox"
                             Grid.Row="1"
                             Margin="0,8,0,18"
                             TextChanged="GuideTitleTextBox_TextChanged" />

                    <TextBlock Grid.Row="2"
                               Text="Selected step"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" />

                    <Grid Grid.Row="3"
                          Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="StepTitleTextBox"
                                 TextChanged="StepTitleTextBox_TextChanged" />
                        <TextBox x:Name="StepBodyTextBox"
                                 Grid.Row="1"
                                 Margin="0,12,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 MinHeight="180"
                                 TextChanged="StepBodyTextBox_TextChanged" />
                    </Grid>

                    <DockPanel Grid.Row="4"
                               Margin="0,18,0,8">
                        <TextBlock Text="Step images"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <WrapPanel>
                            <Button x:Name="ImportImageButton"
                                Content="Import"
                                MinWidth="78"
                                Margin="0,0,8,8"
                                Click="ImportImageButton_Click" />
                            <Button x:Name="PasteImageButton"
                                Content="Paste"
                                MinWidth="78"
                                Margin="0,0,8,8"
                                Click="PasteImageButton_Click" />
                            <Button x:Name="CaptureScreenshotButton"
                                Content="Capture"
                                MinWidth="88"
                                Margin="0,0,8,8"
                                Click="CaptureScreenshotButton_Click" />
                            <Button x:Name="InsertImageReferenceButton"
                                Content="Insert ref"
                                MinWidth="96"
                                Margin="0,0,8,8"
                                Click="InsertImageReferenceButton_Click" />
                            <Button x:Name="RemoveImageButton"
                                Content="Remove"
                                MinWidth="88"
                                Margin="0,0,8,8"
                                Click="RemoveImageButton_Click" />
                        </WrapPanel>
                    </DockPanel>

                    <TabControl Grid.Row="5"
                                MinHeight="180">
                        <TabItem Header="Step">
                            <ListBox x:Name="StepAssetsListBox"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="StepAssetsListBox_PreviewMouseLeftButtonDown"
                                     SelectionChanged="StepAssetsListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Height" Value="82" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6"
                                              Height="70"
                                              Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource CanvasBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Width="96"
                                                    Height="64">
                                                <Grid ClipToBounds="True">
                                                    <Canvas Width="96"
                                                            Height="64">
                                                        <Image Source="{Binding DisplayImageSource}"
                                                               Canvas.Left="{Binding ThumbImageX}"
                                                               Canvas.Top="{Binding ThumbImageY}"
                                                               Width="{Binding ThumbImageWidth}"
                                                               Height="{Binding ThumbImageHeight}"
                                                               Stretch="Fill" />
                                                    </Canvas>
                                                    <ItemsControl ItemsSource="{Binding Annotations}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas Width="96"
                                                                        Height="64" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding ThumbX}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding ThumbY}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding ThumbWidth}"
                                                                        Height="{Binding ThumbHeight}"
                                                                        BorderBrush="{Binding BorderBrush}"
                                                                        BorderThickness="{Binding BorderThickness}"
                                                                        Background="{Binding Background}">
                                                                <TextBlock Text="{Binding Text}"
                                                                           Foreground="{Binding TextBrush}"
                                                                           FontSize="{Binding ThumbFontSize}"
                                                                           FontWeight="{Binding TextFontWeight}"
                                                                           FontStyle="{Binding TextFontStyle}"
                                                                           Margin="3,1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Caption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding RelativePath}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AnnotationSummary}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="Pool">
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="AttachPoolImageButton"
                                        DockPanel.Dock="Top"
                                        Content="Attach to step"
                                        MinWidth="120"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8"
                                        Click="AttachPoolImageButton_Click" />
                                <ListBox x:Name="ImagePoolListBox"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="ImagePoolListBox_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="76" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,6"
                                                  Height="64"
                                                  Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource CanvasBrush}"
                                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Width="88"
                                                        Height="58">
                                                    <Image Source="{Binding FullPath}"
                                                           Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="{Binding RelativePath}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="6"
                                Margin="0,14,0,0">
                    <Border Padding="12"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource CanvasBrush}">
                        <Expander x:Name="CropEditorExpander"
                                  Header="Crop"
                                  IsExpanded="False"
                                  Foreground="{DynamicResource TextBrush}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.CropSummary}"
                                           Grid.ColumnSpan="3"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Button x:Name="ClearCropButton"
                                        Grid.Column="3"
                                        Content="Clear"
                                        MinWidth="72"
                                        HorizontalAlignment="Right"
                                        Click="ClearCropButton_Click" />

                                <TextBlock Grid.Row="1"
                                           Text="X"
                                           Margin="0,10,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="CropXSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,10,10,0"
                                        Minimum="0"
                                        Maximum="100"
                                        ValueChanged="CropSlider_ValueChanged" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=CropXSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,10,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Text="Y"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="CropYSlider"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,8,10,0"
                                        Minimum="0"
                                        Maximum="100"
                                        ValueChanged="CropSlider_ValueChanged" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=CropYSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Grid.Row="3"
                                           Text="Width"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="CropWidthSlider"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,8,10,0"
                                        Minimum="1"
                                        Maximum="100"
                                        ValueChanged="CropSlider_ValueChanged" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=CropWidthSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Grid.Row="4"
                                           Text="Height"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="CropHeightSlider"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,8,10,0"
                                        Minimum="1"
                                        Maximum="100"
                                        ValueChanged="CropSlider_ValueChanged" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=CropHeightSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Expander>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource CanvasBrush}">
                        <Expander x:Name="AnnotationEditorExpander"
                                  Header="Annotations"
                                  IsExpanded="False"
                                  Foreground="{DynamicResource TextBrush}">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel>
                                <WrapPanel DockPanel.Dock="Top"
                                           Margin="0,0,0,8">
                                    <TextBlock Text="Add"
                                               Margin="0,0,8,6"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Button x:Name="AddHighlightButton"
                                            Content="Box"
                                            MinWidth="66"
                                            MinHeight="30"
                                            Padding="10,3"
                                            Margin="0,0,8,6"
                                            Click="AddHighlightButton_Click" />
                                    <Button x:Name="AddLabelButton"
                                            Content="Text"
                                            MinWidth="72"
                                            MinHeight="30"
                                            Padding="10,3"
                                            Margin="0,0,8,6"
                                            Click="AddLabelButton_Click" />
                                    <Button x:Name="AddArrowButton"
                                            Content="Arrow"
                                            MinWidth="72"
                                            MinHeight="30"
                                            Padding="10,3"
                                            Margin="0,0,8,6"
                                            Click="AddArrowButton_Click" />
                                    <Button x:Name="AddRedactButton"
                                            Content="Redact"
                                            MinWidth="78"
                                            MinHeight="30"
                                            Padding="10,3"
                                            Margin="0,0,8,6"
                                            Click="AddRedactButton_Click" />
                                    <Button x:Name="RemoveAnnotationButton"
                                            Content="Delete"
                                            MinWidth="78"
                                            MinHeight="30"
                                            Padding="10,3"
                                            Margin="0,0,8,6"
                                            Click="RemoveAnnotationButton_Click" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="AnnotationListBox"
                                             MinHeight="96"
                                             MaxHeight="210"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="AnnotationListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,4">
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="{Binding PositionSummary}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0">
                                        <Button x:Name="MoveAnnotationUpButton"
                                                Content="▲"
                                                MinWidth="30"
                                                MinHeight="30"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Margin="0,0,0,6"
                                                Click="MoveAnnotationUpButton_Click" />
                                        <Button x:Name="MoveAnnotationDownButton"
                                                Content="▼"
                                                MinWidth="30"
                                                MinHeight="30"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Click="MoveAnnotationDownButton_Click" />
                                    </StackPanel>
                                </Grid>
                                </DockPanel>

                                <Grid Grid.Column="1"
                                      Margin="18,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Text"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBox x:Name="AnnotationTextBox"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         TextChanged="AnnotationTextBox_TextChanged" />

                                <TextBlock Grid.Row="1"
                                           Text="X"
                                           Margin="0,10,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="AnnotationXSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,10,10,0"
                                        Minimum="0"
                                        Maximum="100"
                                        ValueChanged="AnnotationBoundsSlider_ValueChanged" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=AnnotationXSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,10,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Text="Y"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="AnnotationYSlider"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,8,10,0"
                                        Minimum="0"
                                        Maximum="100"
                                        ValueChanged="AnnotationBoundsSlider_ValueChanged" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=AnnotationYSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Grid.Row="3"
                                           Text="Width"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="AnnotationWidthSlider"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,8,10,0"
                                        Minimum="1"
                                        Maximum="100"
                                        ValueChanged="AnnotationBoundsSlider_ValueChanged" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=AnnotationWidthSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Grid.Row="4"
                                           Text="Height"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="AnnotationHeightSlider"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,8,10,0"
                                        Minimum="1"
                                        Maximum="100"
                                        ValueChanged="AnnotationBoundsSlider_ValueChanged" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="{Binding ElementName=AnnotationHeightSlider, Path=Value, StringFormat={}{0:0}%}"
                                           Margin="0,8,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <Border Grid.Row="5"
                                        Grid.ColumnSpan="3"
                                        Margin="0,16,0,8"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="0,1,0,0" />

                                <Grid x:Name="LabelStylePanel"
                                      Grid.Row="6"
                                      Grid.ColumnSpan="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Size"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Slider x:Name="LabelFontSizeSlider"
                                            Grid.Column="1"
                                            Margin="0,0,10,0"
                                            Minimum="8"
                                            Maximum="36"
                                            ValueChanged="LabelStyle_ValueChanged" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ElementName=LabelFontSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />

                                    <TextBlock Grid.Row="1"
                                               Text="Style"
                                               Margin="0,8,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal">
                                        <ToggleButton x:Name="LabelBoldToggle"
                                                      Content="B"
                                                      MinWidth="34"
                                                      Width="34"
                                                      Height="30"
                                                      Padding="0"
                                                      FontWeight="Bold"
                                                      Click="LabelStyleToggle_Click" />
                                        <ToggleButton x:Name="LabelItalicToggle"
                                                      Content="I"
                                                      MinWidth="34"
                                                      Width="34"
                                                      Height="30"
                                                      Padding="0"
                                                      Margin="8,0,0,0"
                                                      FontStyle="Italic"
                                                      Click="LabelStyleToggle_Click" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2"
                                               Text="Text"
                                               Margin="0,10,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#FFFFFF" Click="LabelTextColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#202124" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#202124" Click="LabelTextColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#FBBC04" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#FBBC04" Click="LabelTextColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Background="#EA4335" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#EA4335" Click="LabelTextColorButton_Click" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="3"
                                               Text="Box"
                                               Margin="0,10,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Grid.Row="3"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#1A73E8" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#1A73E8" Click="LabelBackgroundColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#34A853" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#34A853" Click="LabelBackgroundColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#FBBC04" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#FBBC04" Click="LabelBackgroundColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,0,8,0" Background="#EA4335" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#EA4335" Click="LabelBackgroundColorButton_Click" />
                                        <Button Width="28" Height="28" MinWidth="28" Padding="0" Background="#202124" BorderBrush="{DynamicResource BorderBrushSoft}" Tag="#202124" Click="LabelBackgroundColorButton_Click" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4"
                                               Text="Opacity"
                                               Margin="0,10,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Slider x:Name="LabelBackgroundOpacitySlider"
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Margin="0,10,10,0"
                                            Minimum="25"
                                            Maximum="100"
                                            ValueChanged="LabelStyle_ValueChanged" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=LabelBackgroundOpacitySlider, Path=Value, StringFormat={}{0:0}%}"
                                               Margin="0,10,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                </Grid>
                            </Grid>
                        </Expander>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <Border Grid.Column="3"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="20,0,0,0"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10"
                               LastChildFill="False">
                        <TextBlock Text="Workspace"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock x:Name="PreviewPathTextBlock"
                                   DockPanel.Dock="Right"
                                   Text="Not generated"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TabControl x:Name="WorkspaceTabControl"
                                Grid.Row="1">
                        <TabItem x:Name="GuidePreviewTab"
                                 Header="Guide">
                            <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    Background="#FFFFFF">
                                <WebBrowser x:Name="GuidePreviewBrowser" />
                            </Border>
                        </TabItem>
                        <TabItem x:Name="ImagePreviewTab"
                                 Header="Image">
                            <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    Background="#FFFFFF"
                                    ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid x:Name="WorkspaceImageSurface"
                                          Width="760"
                                          Height="520"
                                          Background="Transparent"
                                          PreviewMouseMove="WorkspaceImageSurface_PreviewMouseMove"
                                          PreviewMouseLeftButtonUp="WorkspaceImageSurface_PreviewMouseLeftButtonUp">
                                        <Canvas Width="760"
                                                Height="520">
                                            <Image Source="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.DisplayImageSource}"
                                                   Canvas.Left="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.WorkspaceImageX}"
                                                   Canvas.Top="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.WorkspaceImageY}"
                                                   Width="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.WorkspaceImageWidth}"
                                                   Height="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.WorkspaceImageHeight}"
                                                   Stretch="Fill" />
                                        </Canvas>
                                        <ItemsControl ItemsSource="{Binding ElementName=StepAssetsListBox, Path=SelectedItem.Annotations}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="760"
                                                            Height="520" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding WorkspaceX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding WorkspaceY}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding WorkspaceWidthValue}"
                                                            Height="{Binding WorkspaceHeightValue}"
                                                            BorderBrush="{Binding BorderBrush}"
                                                            BorderThickness="{Binding BorderThickness}"
                                                            Background="{Binding Background}"
                                                            Cursor="SizeAll"
                                                            PreviewMouseLeftButtonDown="WorkspaceAnnotation_PreviewMouseLeftButtonDown">
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding TextBrush}"
                                                                   FontSize="{Binding WorkspaceFontSize}"
                                                                   FontWeight="{Binding TextFontWeight}"
                                                                   FontStyle="{Binding TextFontStyle}"
                                                                   Margin="6,3"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,9">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="DirtyIndicatorTextBlock"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready. Local-only MVP. No telemetry. No cloud."
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
